{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pip install -r SENTINEL-BOT-Main/requirements.txt"
  },
  "deploy": {
    "startCommand": "cd SENTINEL-BOT-Main && gunicorn --bind 0.0.0.0:$PORT --workers 1 --timeout 120 wsgi:app",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
