# ============================================================
# SP4RK OS / SENTINEL BOT — Environment Variables Reference
# ============================================================
# Copy this file to .env and fill in your values.
# Lines beginning with # are comments and are ignored.
#
#   cp .env.example .env
#
# NEVER commit your .env file to version control.
# ============================================================


# ────────────────────────────────────────────────────────────
# REQUIRED — Discord Bot
# ────────────────────────────────────────────────────────────

# Your bot's token from https://discord.com/developers/applications
DISCORD_TOKEN=


# ────────────────────────────────────────────────────────────
# REQUIRED — Flask / Web Dashboard
# ────────────────────────────────────────────────────────────

# Cryptographically random string used to sign session cookies.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Your Discord user ID. Grants you access to the Owner Panel (/owner).
# Find it in Discord: Settings → Advanced → Developer Mode → right-click your name.


# ────────────────────────────────────────────────────────────
# DATABASE (choose one; both are optional — falls back to JSON files)
# ────────────────────────────────────────────────────────────

# PostgreSQL connection string. Recommended for persistence across restarts.
# Format: postgresql://user:password@host:5432/dbname
# Local Docker example (see docker-compose.yml): postgresql://sp4rk:sp4rkpass@localhost:5432/sp4rkdb
DATABASE_URL=

# Supabase (alternative to raw Postgres). Leave blank to skip.
SUPABASE_URL=
SUPABASE_KEY=


# ────────────────────────────────────────────────────────────
# AI MODERATION (optional)
# ────────────────────────────────────────────────────────────

# Google Gemini API key for AI-powered auto-moderation.
# Get one at https://aistudio.google.com/app/apikey
GEMINI_KEY=
# Legacy alias — either name works:
# GOOGLE_API_KEY=


# ────────────────────────────────────────────────────────────
# SERVER CONFIGURATION
# ────────────────────────────────────────────────────────────

# Port the Flask app listens on (default: 5000)
PORT=5000

# Public-facing URL of your dashboard. Used for the keepalive self-ping.
# Leave blank for local dev (falls back to http://localhost:PORT).
DASHBOARD_URL=

# Set to "true" when running behind an HTTPS reverse proxy
# so session cookies are marked Secure. Leave blank for local HTTP.
FORCE_HTTPS_COOKIES=

# Set to "true" to have gunicorn/wsgi start the bot in the same process.
# Required when deploying to a single-process host (Render free tier, Railway, etc.).
START_BOT_IN_WEB=true


# ────────────────────────────────────────────────────────────
# DEV / OWNER PANEL
# ────────────────────────────────────────────────────────────

# PIN to access the developer panel at /dev. CHANGE THIS in production.

# Test bot token used in the /dev test console. Separate from the main bot.
TESTCORD_TOKEN=
TEST_GUILD_ID=


# ────────────────────────────────────────────────────────────
# SERVER OFFICIAL (second bot — optional)
# ────────────────────────────────────────────────────────────

SERVER_TOKEN=
SERVER_OFFICIAL_CLIENT_ID=
SERVER_OFFICIAL_PERMISSIONS=8


# ────────────────────────────────────────────────────────────
# EMAIL NOTIFICATIONS (optional — either SMTP or Resend)
# ────────────────────────────────────────────────────────────

# Resend (https://resend.com) — recommended
RESEND_API_KEY=

# Classic SMTP (Gmail, Mailgun, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=


# ────────────────────────────────────────────────────────────
# SOCIAL ALERTS (optional)
# ────────────────────────────────────────────────────────────

# Twitch live alerts
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=


# ────────────────────────────────────────────────────────────
# WAVE ROOMS (optional feature)
# ────────────────────────────────────────────────────────────

# Auth token for Wave room host operations.
W_TOKEN=
